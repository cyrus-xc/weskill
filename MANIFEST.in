include README.md
include .agents/plugins/marketplace.json .claude-plugin/marketplace.json
include native/readonly_executor_shim.c native/readonly_executor_shim.S
include scripts/run_local_mcp.py scripts/check_release.py
recursive-include docs *.md
recursive-include assets *.svg *.png *.gif
recursive-include plugins *.json *.md *.yaml *.svg *.png
prune research
prune .state
prune native/build
global-exclude __pycache__ *.py[cod] *.core *.log
include tools/render_demo.py
include package.json package-lock.json
recursive-include bin *.mjs
recursive-include lib *.mjs *.py
include tools/check_npm_package.mjs
recursive-include tests/npm *.mjs
include tools/smoke_npm.py tools/build_release.py
recursive-include .github/workflows *.yml
